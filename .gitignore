*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# conda / venv
.venv/
venv/
env/

# OS · 에디터
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# 개인 환경·비밀키
.env
*.local

